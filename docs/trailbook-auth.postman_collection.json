{
  "info": {
    "_postman_id": "6d611db9-97b4-43bb-aad4-bf80ce9730e6",
    "name": "Trailbook Auth",
    "description": "Auth and health endpoints for Trailbook server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://192.168.10.148:3001/api"
    },
    {
      "key": "email",
      "value": "slavisacicovic@gmail.com"
    },
    {
      "key": "password",
      "value": "changeme123"
    },
    {
      "key": "displayName",
      "value": "Slavisa"
    },
    {
      "key": "sessionToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Providers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/providers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "providers"
          ]
        }
      }
    },
    {
      "name": "Mobile Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const payload = pm.response.json();",
              "if (payload && payload.sessionToken) {",
              "  pm.collectionVariables.set('sessionToken', payload.sessionToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"{{displayName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/mobile/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "mobile",
            "register"
          ]
        }
      }
    },
    {
      "name": "Mobile Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const payload = pm.response.json();",
              "if (payload && payload.sessionToken) {",
              "  pm.collectionVariables.set('sessionToken', payload.sessionToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/mobile/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "mobile",
            "login"
          ]
        }
      }
    },
    {
      "name": "Mobile Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/mobile/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "mobile",
            "me"
          ]
        }
      }
    },
    {
      "name": "Mobile Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/mobile/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "mobile",
            "logout"
          ]
        }
      }
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
