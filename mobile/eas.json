{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_DATA_TOOLS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_DATA_TOOLS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "gradleCommand": ":app:bundleProdRelease"
      }
    },
    "production-android": {
      "extends": "production",
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/prodRelease/mapping.txt"
      ]
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6789852326"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
