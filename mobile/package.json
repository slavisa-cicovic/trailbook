{
  "name": "trailbook",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:local": "node scripts/run-android.js localRelease com.slavisacicovic.trailbook.local",
    "android:local:debug": "node scripts/run-android.js localDebug com.slavisacicovic.trailbook.local",
    "android:local:encrypted": "node scripts/run-android.js localEncryptedRelease com.slavisacicovic.trailbook.local.encrypted",
    "android:local:encrypted:e2e": "EXPO_PUBLIC_E2E_ENABLED=true node scripts/run-android.js localEncryptedRelease com.slavisacicovic.trailbook.local.encrypted",
    "android:local:encrypted:optimized": "node scripts/run-android.js localEncryptedOptimized com.slavisacicovic.trailbook.local.encrypted",
    "android:local:encrypted:optimized:e2e": "EXPO_PUBLIC_E2E_ENABLED=true node scripts/run-android.js localEncryptedOptimized com.slavisacicovic.trailbook.local.encrypted",
    "android:local:encrypted:debug": "node scripts/run-android.js localEncryptedDebug com.slavisacicovic.trailbook.local.encrypted",
    "android:test": "node scripts/run-android.js qaDebug com.slavisacicovic.trailbook.test",
    "android:prod": "node scripts/run-android.js prodRelease com.slavisacicovic.trailbook",
    "ios": "expo run:ios",
    "test:processing": "node --import tsx --test test/processing/*.test.ts",
    "test:android:memory": "bash scripts/test-android-memory.sh",
    "lint": "eslint src app --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "generate:licenses": "node scripts/generate-open-source-licenses.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "eas:build:ios:preview": "eas build --platform ios --profile preview",
    "eas:update:preview": "eas update --branch preview",
    "eas:update:production": "eas update --branch production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.37",
    "expo-application": "~7.0.7",
    "expo-background-task": "~1.0.10",
    "expo-battery": "~10.0.8",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-iap": "^4.4.1",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-navigation-bar": "~5.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.8",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "fflate": "^0.8.3",
    "mitt": "^3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "trailbook-native-location": "file:./modules/trailbook-native-location",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "ajv": "^8.20.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.3.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
