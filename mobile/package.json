{
  "name": "@trailbook/mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "eas:build:ios:preview": "eas build --platform ios --profile preview",
    "eas:build:ios:production": "eas build --platform ios --profile production",
    "eas:build:android:preview": "eas build --platform android --profile preview",
    "eas:build:android:production": "eas build --platform android --profile production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"Lint is not configured yet for mobile.\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-battery": "^55.0.13",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.7",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.8",
    "expo-web-browser": "^55.0.13",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.1",
    "typescript": "~5.9.2"
  }
}
