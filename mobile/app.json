{
  "expo": {
    "name": "Trailbook",
    "slug": "trailbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.slavisacicovic.trailbook"
    },
    "android": {
      "package": "com.slavisacicovic.trailbook"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
