{
  "expo": {
    "name": "Trailbook",
    "slug": "trailbook",
    "scheme": "trailbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trailbook uses your photos so you can attach images to route waypoints.",
          "cameraPermission": "Trailbook uses your camera so you can capture waypoint photos during recording."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trailbook uses your location to show where you are and support trip recording."
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/app-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.slavisacicovic.trailbook"
    },
    "android": {
      "package": "com.slavisacicovic.trailbook",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3efe6"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
