{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "react",
      "react-native",
      "expo-router/types"
    ]
  },
  "include": [
    "app/**/*",
    "src/**/*"
  ]
}
