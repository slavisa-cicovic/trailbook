{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "expo-location": [
        "../node_modules/expo-location"
      ],
      "react-native-maps": [
        "../node_modules/react-native-maps"
      ]
    },
    "types": [
      "react",
      "react-native",
      "expo-router/types"
    ]
  },
  "include": [
    "app/**/*",
    "src/**/*"
  ]
}
