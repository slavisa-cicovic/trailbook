{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server DB: Up",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run db:up --workspace server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Server DB: Init",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run db:init --workspace server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Server DB: Down",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run db:down --workspace server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Server: Test Auth",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test --workspace server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Server: Nest Start (Dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start:dev --workspace server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Server: Nest Start",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start --workspace server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web: Next Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev --workspace web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web: Next Start",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start --workspace web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Mobile: Expo Start",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start --workspace mobile",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Mobile: Expo Start (Clear Cache)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start:clear",
      "cwd": "${workspaceFolder}/mobile"
    },
    {
      "name": "Mobile: Run iOS",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run ios",
      "cwd": "${workspaceFolder}/mobile"
    },
    {
      "name": "Mobile: Run Android",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run android",
      "cwd": "${workspaceFolder}/mobile"
    }
  ]
}
