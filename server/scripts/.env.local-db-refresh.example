# Copy this file to .env.local-db-refresh and replace the placeholders.
# The real file is ignored by Git and loaded automatically by the refresh script.

TRAILBOOK_SOURCE_DATABASE_URL='postgresql://USER:PASSWORD@AWS_HOST:5432/trailbook?sslmode=require'
TRAILBOOK_KEEP_USER_EMAIL='reviewer@example.com'
TRAILBOOK_ALLOW_LOCAL_DB_REPLACE='YES'
# Enable only when the source database contains controlled test data.
TRAILBOOK_RETAIN_ALL_TEST_DATA=false

# Optional: these defaults already match server/docker-compose.yml.
# TRAILBOOK_LOCAL_DATABASE_URL='postgresql://trailbook:trailbook@localhost:55432/trailbook'
# TRAILBOOK_LOCAL_BACKUP_DIR='/absolute/path/for/local/database/backups'
# TRAILBOOK_POSTGRES_IMAGE='postgres:18-alpine'
