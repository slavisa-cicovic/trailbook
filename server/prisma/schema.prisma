generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id                BigInt          @id @default(autoincrement())
  clientTripId      String          @unique @map("client_trip_id") @db.VarChar(36)
  userId            String          @map("user_id") @db.Uuid
  title             String          @db.VarChar(500)
  description       String?
  startedAt         DateTime        @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?       @map("ended_at") @db.Timestamptz(6)
  status            String          @db.VarChar(50)
  processingVersion Int             @default(0) @map("processing_version")
  rawBundle         Json            @map("raw_bundle") @db.JsonB
  shareToken        String?         @unique @map("share_token") @db.VarChar(64)
  sharePinHash      String?         @map("share_pin_hash") @db.VarChar(64)
  shareEnabled      Boolean         @default(false) @map("share_enabled")
  sharedAt          DateTime?       @map("shared_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userShares        TripUserShare[]

  @@index([shareToken], map: "trips_share_token_idx")
  @@index([startedAt(sort: Desc)], map: "trips_started_at_idx")
  @@index([userId], map: "trips_user_id_idx")
  @@map("trips")
}

model TripUserShare {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientTripId    String    @map("client_trip_id") @db.VarChar(36)
  ownerUserId     String    @map("owner_user_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  trip            Trip      @relation(fields: [clientTripId], references: [clientTripId], onDelete: Cascade)
  owner           User      @relation("TripUserShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipient       User      @relation("TripUserShareRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([clientTripId, recipientUserId], map: "trip_user_shares_trip_recipient_key")
  @@index([ownerUserId], map: "trip_user_shares_owner_idx")
  @@index([recipientUserId], map: "trip_user_shares_recipient_idx")
  @@index([clientTripId], map: "trip_user_shares_trip_idx")
  @@map("trip_user_shares")
}

model TripGroup {
  id            BigInt    @id @default(autoincrement())
  clientGroupId String    @unique @map("client_group_id") @db.VarChar(36)
  userId        String    @map("user_id") @db.Uuid
  title         String    @db.VarChar(500)
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "trip_groups_user_id_idx")
  @@map("trip_groups")
}

model TripGroupMember {
  id             BigInt    @id @default(autoincrement())
  clientMemberId String    @unique @map("client_member_id") @db.VarChar(36)
  clientGroupId  String    @map("client_group_id") @db.VarChar(36)
  clientTripId   String    @map("client_trip_id") @db.VarChar(36)
  userId         String    @map("user_id") @db.Uuid
  orderIndex     Int       @map("order_index")
  addedAt        DateTime  @map("added_at") @db.Timestamptz(6)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "trip_group_members_user_id_idx")
  @@index([clientGroupId], map: "trip_group_members_group_idx")
  @@index([clientTripId], map: "trip_group_members_trip_idx")
  @@map("trip_group_members")
}

model User {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String                      @unique @db.VarChar(255)
  displayName                String                      @map("display_name") @db.VarChar(100)
  role                       String                      @default("user") @db.VarChar(50)
  appleAppAccountToken       String                      @unique @default(dbgenerated("gen_random_uuid()")) @map("apple_app_account_token") @db.Uuid
  localTestTripClientId      String?                     @map("local_test_trip_client_id") @db.VarChar(255)
  localTestTripUsedAt        DateTime?                   @map("local_test_trip_used_at") @db.Timestamptz(6)
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  trips                      Trip[]
  tripGroups                 TripGroup[]
  tripGroupMembers           TripGroupMember[]
  ownedTripShares            TripUserShare[]             @relation("TripUserShareOwner")
  receivedTripShares         TripUserShare[]             @relation("TripUserShareRecipient")
  refreshTokens              RefreshToken[]
  purchaseAccess             PurchaseAccess?
  purchaseEvents             PurchaseEvent[]
  applePurchaseNotifications ApplePurchaseNotification[]

  @@map("users")
}

model ApplePurchaseNotification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  notificationUuid String?   @unique @map("notification_uuid") @db.VarChar(100)
  payloadHash      String    @unique @map("payload_hash") @db.VarChar(64)
  signedPayload    String    @map("signed_payload") @db.Text
  environment      String?   @db.VarChar(50)
  notificationType String?   @map("notification_type") @db.VarChar(100)
  subtype          String?   @db.VarChar(100)
  processingStatus String    @default("received") @map("processing_status") @db.VarChar(50)
  attemptCount     Int       @default(0) @map("attempt_count")
  lastError        String?   @map("last_error") @db.Text
  decodedPayload   Json?     @map("decoded_payload") @db.JsonB
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  lastAttemptAt    DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([processingStatus, receivedAt], map: "apple_purchase_notifications_status_received_idx")
  @@index([userId, receivedAt(sort: Desc)], map: "apple_purchase_notifications_user_received_idx")
  @@map("apple_purchase_notifications")
}

model PurchaseAccess {
  userId                String    @id @map("user_id") @db.Uuid
  planCode              String    @map("plan_code") @db.VarChar(100)
  subscriptionStatus    String    @map("subscription_status") @db.VarChar(50)
  provider              String?   @db.VarChar(50)
  environment           String?   @db.VarChar(50)
  providerProductId     String?   @map("provider_product_id") @db.VarChar(255)
  originalTransactionId String?   @map("original_transaction_id") @db.VarChar(255)
  autoRenewEnabled      Boolean?  @map("auto_renew_enabled")
  currentPeriodEndsAt   DateTime? @map("current_period_ends_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz(6)
  entitlements          Json      @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("purchase_access")
}

model PurchaseEvent {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  provider              String    @db.VarChar(50)
  environment           String    @db.VarChar(50)
  providerProductId     String    @map("provider_product_id") @db.VarChar(255)
  transactionId         String    @map("transaction_id") @db.VarChar(255)
  originalTransactionId String?   @map("original_transaction_id") @db.VarChar(255)
  eventType             String    @map("event_type") @db.VarChar(50)
  result                String    @db.VarChar(50)
  purchasedAt           DateTime? @map("purchased_at") @db.Timestamptz(6)
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  idempotencyKey        String    @unique @map("idempotency_key") @db.VarChar(500)
  rawPayload            Json      @map("raw_payload") @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, transactionId], map: "purchase_events_provider_transaction_idx")
  @@index([userId, createdAt(sort: Desc)], map: "purchase_events_user_created_at_idx")
  @@index([provider, originalTransactionId], map: "purchase_events_original_transaction_idx")
  @@map("purchase_events")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token], map: "refresh_tokens_token_idx")
  @@map("refresh_tokens")
}

model WaypointImage {
  id                 String    @id @db.VarChar(36)
  waypointId         String    @map("waypoint_id") @db.VarChar(36)
  imageUuid          String    @default(dbgenerated("gen_random_uuid()")) @map("image_uuid") @db.VarChar(36)
  objectKey          String    @map("object_key")
  contentType        String?   @map("content_type") @db.VarChar(100)
  sizeBytes          Int?      @map("size_bytes")
  uploadStatus       String    @default("pending") @map("upload_status") @db.VarChar(50)
  uploadAttemptCount Int       @default(0) @map("upload_attempt_count")
  lastUploadError    String?   @map("last_upload_error")
  uploadedAt         DateTime? @map("uploaded_at") @db.Timestamptz(6)
  remoteVerifiedAt   DateTime? @map("remote_verified_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([imageUuid], map: "waypoint_images_image_uuid_idx")
  @@index([waypointId], map: "waypoint_images_waypoint_id_idx")
  @@map("waypoint_images")
}
