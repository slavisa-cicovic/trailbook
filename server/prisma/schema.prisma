generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  test_user
  admin

  @@map("user_role")
}

enum AuthProvider {
  local
  google
  facebook
  apple

  @@map("auth_provider")
}

enum PlanBillingType {
  none
  monthly
  yearly
  lifetime

  @@map("plan_billing_type")
}

enum SubscriptionStatus {
  active
  expired
  canceled
  lifetime

  @@map("subscription_status")
}

enum MailOutboxStatus {
  pending
  sent
  failed

  @@map("mail_outbox_status")
}

enum RecordingProfile {
  walk
  bike
  drive
  boat
  plane
  stationary

  @@map("recording_profile")
}

enum WaypointCategory {
  generic
  departure
  fuel
  border
  port
  ferry
  restaurant
  cafe
  viewpoint
  monument
  beach

  @@map("waypoint_category")
}

enum TripShareStatus {
  active
  revoked

  @@map("trip_share_status")
}

enum WaypointAttachmentType {
  photo

  @@map("waypoint_attachment_type")
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  displayName         String              @map("display_name")
  role                UserRole            @default(user)
  passwordHash        String?             @map("password_hash")
  emailVerifiedAt     DateTime?           @map("email_verified_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  lastLoginAt         DateTime?           @map("last_login_at")
  externalIdentities  ExternalIdentity[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  subscriptions       Subscription[]
  mailOutboxEntries   MailOutbox[]
  ownedTrips          Trip[]              @relation("OwnedTrips")
  ownedTripGroups     TripGroup[]         @relation("OwnedTripGroups")
  ownedTripGroupMembers TripGroupMember[] @relation("OwnedTripGroupMembers")
  ownedTripShares     TripShare[]         @relation("OwnerTripShares")
  receivedTripShares  TripShare[]         @relation("RecipientTripShares")
  waypointAttachments WaypointAttachment[]

  @@map("users")
}

model ExternalIdentity {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  email           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("external_identities")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens AccessToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AccessToken {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("access_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Plan {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  billingType   PlanBillingType  @map("billing_type")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @map("user_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus
  startedAt           DateTime           @map("started_at")
  currentPeriodEndsAt DateTime?          @map("current_period_ends_at")
  canceledAt          DateTime?          @map("canceled_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
  @@map("subscriptions")
}

model MailOutbox {
  id            String           @id @default(cuid())
  userId        String?          @map("user_id")
  toEmail       String           @map("to_email")
  subject       String
  textBody      String           @map("text_body")
  htmlBody      String           @map("html_body")
  status        MailOutboxStatus @default(pending)
  provider      String?
  providerId    String?          @map("provider_id")
  errorMessage  String?          @map("error_message")
  sentAt        DateTime?        @map("sent_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("mail_outbox")
}

model MobileRecordingConfig {
  id        String   @id
  configJson Json    @map("config_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mobile_recording_configs")
}

model Trip {
  id               String           @id @default(cuid())
  ownerUserId      String           @map("owner_user_id")
  ownerDeviceId    String           @map("owner_device_id")
  localSourceId    String           @map("local_source_id")
  title            String
  description      String?
  recordingProfile RecordingProfile @map("recording_profile")
  recordingConfigJson Json?         @map("recording_config_json")
  batteryStartLevelPercent Float?   @map("battery_start_level_percent")
  batteryStartState String?         @map("battery_start_state")
  batteryEndLevelPercent Float?     @map("battery_end_level_percent")
  batteryEndState String?           @map("battery_end_state")
  pointCount       Int?             @map("point_count")
  distanceMeters   Float?           @map("distance_meters")
  statsUpdatedAt   DateTime?        @map("stats_updated_at")
  startedAt        DateTime         @map("started_at")
  endedAt          DateTime?        @map("ended_at")
  createdAt        DateTime         @map("created_at")
  updatedAt        DateTime         @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")
  owner            User             @relation("OwnedTrips", fields: [ownerUserId], references: [id], onDelete: Cascade)
  segments         TripSegment[]
  points           TripPoint[]
  diagnostics      TripDiagnostics[]
  rawLocationEvents RawLocationEvent[]
  routeVariants    TripRouteVariant[]
  waypoints        Waypoint[]
  shares           TripShare[]
  attachments      WaypointAttachment[]
  groupMemberships TripGroupMember[]

  @@unique([ownerUserId, localSourceId])
  @@index([ownerUserId])
  @@map("trips")
}

model TripGroup {
  id            String            @id @default(cuid())
  ownerUserId   String            @map("owner_user_id")
  localSourceId String            @map("local_source_id")
  title         String
  description   String?
  createdAt     DateTime          @map("created_at")
  updatedAt     DateTime          @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")
  owner         User              @relation("OwnedTripGroups", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members       TripGroupMember[]

  @@unique([ownerUserId, localSourceId])
  @@index([ownerUserId])
  @@map("trip_groups")
}

model TripGroupMember {
  id                 String    @id @default(cuid())
  ownerUserId        String    @map("owner_user_id")
  groupId            String    @map("group_id")
  groupLocalSourceId String    @map("group_local_source_id")
  tripId             String    @map("trip_id")
  tripLocalSourceId  String    @map("trip_local_source_id")
  localSourceId      String    @map("local_source_id")
  sortOrder          Int       @map("sort_order")
  createdAt          DateTime  @map("created_at")
  updatedAt          DateTime  @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  owner              User      @relation("OwnedTripGroupMembers", fields: [ownerUserId], references: [id], onDelete: Cascade)
  group              TripGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trip               Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, localSourceId])
  @@index([ownerUserId])
  @@index([groupId])
  @@index([tripId])
  @@map("trip_group_members")
}

model TripDiagnostics {
  id                       String   @id @default(cuid())
  tripId                   String   @map("trip_id")
  deviceId                 String   @map("device_id")
  platform                 String
  recordingMode            String   @map("recording_mode")
  callbackCount            Int      @map("callback_count")
  decisionCount            Int      @map("decision_count")
  accepted                 Int
  acceptedAfterLongGap     Int      @map("accepted_after_long_gap")
  foregroundCallbacks      Int      @map("foreground_callbacks")
  backgroundCallbacks      Int      @map("background_callbacks")
  foregroundAccepted       Int      @map("foreground_accepted")
  backgroundAccepted       Int      @map("background_accepted")
  foregroundRejected       Int      @map("foreground_rejected")
  backgroundRejected       Int      @map("background_rejected")
  duplicateTimestamp       Int      @map("duplicate_timestamp")
  duplicateCoordinates     Int      @map("duplicate_coordinates")
  sessionDuplicateRecordedAt Int    @map("session_duplicate_recorded_at")
  rejectedByAccuracy       Int      @map("rejected_by_accuracy")
  rejectedByMinMovement    Int      @map("rejected_by_min_movement")
  rejectedByJumpDistance   Int      @map("rejected_by_jump_distance")
  rejectedByImpliedSpeed   Int      @map("rejected_by_implied_speed")
  maxCallbackGapMs         Int      @map("max_callback_gap_ms")
  maxRecordedGapMs         Int      @map("max_recorded_gap_ms")
  maxSilentGapMs           Int      @default(0) @map("max_silent_gap_ms")
  silentGapCount           Int      @default(0) @map("silent_gap_count")
  accuracyHistogramJson    Json?    @map("accuracy_histogram_json")
  recentEventsJson         Json?    @map("recent_events_json")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  trip                     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, deviceId])
  @@index([tripId])
  @@map("trip_diagnostics")
}

model TripSegment {
  id               String           @id @default(cuid())
  tripId           String           @map("trip_id")
  localSourceId    String           @map("local_source_id")
  recordingProfile RecordingProfile @map("recording_profile")
  pointCount        Int?             @map("point_count")
  distanceMeters    Float?           @map("distance_meters")
  durationMs        Int?             @map("duration_ms")
  statsUpdatedAt    DateTime?        @map("stats_updated_at")
  startedAt        DateTime         @map("started_at")
  endedAt          DateTime?        @map("ended_at")
  createdAt        DateTime         @map("created_at")
  updatedAt        DateTime         @map("updated_at")
  trip             Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  points           TripPoint[]
  waypoints        Waypoint[]

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@map("trip_segments")
}

model TripPoint {
  id            String       @id @default(cuid())
  tripId        String       @map("trip_id")
  segmentId     String?      @map("segment_id")
  localSourceId String       @map("local_source_id")
  latitude      Float
  longitude     Float
  recordedAt    DateTime     @map("recorded_at")
  accuracy      Float?
  altitude      Float?
  speed         Float?
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  segment       TripSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@index([segmentId])
  @@map("trip_points")
}

model RawLocationEvent {
  id                              String   @id @default(cuid())
  tripId                          String   @map("trip_id")
  localSourceId                   String   @map("local_source_id")
  sessionStartedAt                DateTime? @map("session_started_at")
  activeSegmentLocalSourceId      String?  @map("active_segment_local_source_id")
  batchId                         String   @map("batch_id")
  batchIndex                      Int      @map("batch_index")
  callbackSource                  String   @map("callback_source")
  origin                          String
  receivedAt                      DateTime @map("received_at")
  recordedAt                      DateTime @map("recorded_at")
  latitude                        Float
  longitude                       Float
  accuracy                        Float?
  altitude                        Float?
  speed                           Float?
  processingStatus                String   @map("processing_status")
  processingDecision              String?  @map("processing_decision")
  processedAt                     DateTime? @map("processed_at")
  acceptedTripPointLocalSourceId  String?  @map("accepted_trip_point_local_source_id")
  segmentLocalSourceId            String?  @map("segment_local_source_id")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")
  trip                            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@index([tripId, recordedAt])
  @@map("raw_location_events")
}

model TripRouteVariant {
  id            String   @id @default(cuid())
  tripId        String   @map("trip_id")
  localSourceId String   @map("local_source_id")
  variantType   String   @map("variant_type")
  provider      String
  geometryJson  Json     @map("geometry_json")
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@map("trip_route_variants")
}

model Waypoint {
  id            String           @id @default(cuid())
  tripId        String           @map("trip_id")
  segmentId     String?          @map("segment_id")
  localSourceId String           @map("local_source_id")
  category      WaypointCategory
  latitude      Float
  longitude     Float
  title         String
  note          String?
  createdAt     DateTime         @map("created_at")
  updatedAt     DateTime         @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")
  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  segment       TripSegment?     @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  attachments   WaypointAttachment[]

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@index([segmentId])
  @@map("waypoints")
}

model WaypointAttachment {
  id                  String                 @id @default(cuid())
  tripId              String                 @map("trip_id")
  waypointId          String                 @map("waypoint_id")
  ownerUserId         String                 @map("owner_user_id")
  localSourceId       String                 @map("local_source_id")
  waypointLocalSourceId String               @map("waypoint_local_source_id")
  type                WaypointAttachmentType
  mimeType            String?                @map("mime_type")
  originalFilename    String?                @map("original_filename")
  storageKey          String?                @map("storage_key")
  fileSizeBytes       Int?                   @map("file_size_bytes")
  createdAt           DateTime               @map("created_at")
  updatedAt           DateTime               @map("updated_at")
  deletedAt           DateTime?              @map("deleted_at")
  trip                Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  waypoint            Waypoint               @relation(fields: [waypointId], references: [id], onDelete: Cascade)
  owner               User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@index([waypointId])
  @@index([ownerUserId])
  @@map("waypoint_attachments")
}

model TripShare {
  id              String          @id @default(cuid())
  tripId          String          @map("trip_id")
  ownerUserId     String          @map("owner_user_id")
  recipientUserId String          @map("recipient_user_id")
  status          TripShareStatus @default(active)
  revokedAt       DateTime?       @map("revoked_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  owner           User            @relation("OwnerTripShares", fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipient       User            @relation("RecipientTripShares", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([tripId, recipientUserId])
  @@index([ownerUserId])
  @@index([recipientUserId])
  @@map("trip_shares")
}
