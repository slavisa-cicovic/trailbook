generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum AuthProvider {
  local
  google
  facebook
  apple

  @@map("auth_provider")
}

enum PlanBillingType {
  none
  monthly
  yearly
  lifetime

  @@map("plan_billing_type")
}

enum SubscriptionStatus {
  active
  expired
  canceled
  lifetime

  @@map("subscription_status")
}

enum MailOutboxStatus {
  pending
  sent
  failed

  @@map("mail_outbox_status")
}

enum RecordingProfile {
  walk
  bike
  drive
  boat
  plane

  @@map("recording_profile")
}

enum WaypointCategory {
  generic
  departure
  fuel
  border
  port
  ferry
  restaurant
  cafe
  viewpoint
  monument
  beach

  @@map("waypoint_category")
}

enum TripShareStatus {
  active
  revoked

  @@map("trip_share_status")
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  displayName         String              @map("display_name")
  role                UserRole            @default(user)
  passwordHash        String?             @map("password_hash")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  lastLoginAt         DateTime?           @map("last_login_at")
  externalIdentities  ExternalIdentity[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  mailOutboxEntries   MailOutbox[]
  ownedTrips          Trip[]              @relation("OwnedTrips")
  ownedTripShares     TripShare[]         @relation("OwnerTripShares")
  receivedTripShares  TripShare[]         @relation("RecipientTripShares")

  @@map("users")
}

model ExternalIdentity {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  email           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("external_identities")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Plan {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  billingType   PlanBillingType  @map("billing_type")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @map("user_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus
  startedAt           DateTime           @map("started_at")
  currentPeriodEndsAt DateTime?          @map("current_period_ends_at")
  canceledAt          DateTime?          @map("canceled_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
  @@map("subscriptions")
}

model MailOutbox {
  id            String           @id @default(cuid())
  userId        String?          @map("user_id")
  toEmail       String           @map("to_email")
  subject       String
  textBody      String           @map("text_body")
  htmlBody      String           @map("html_body")
  status        MailOutboxStatus @default(pending)
  provider      String?
  providerId    String?          @map("provider_id")
  errorMessage  String?          @map("error_message")
  sentAt        DateTime?        @map("sent_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("mail_outbox")
}

model Trip {
  id               String           @id @default(cuid())
  ownerUserId      String           @map("owner_user_id")
  ownerDeviceId    String           @map("owner_device_id")
  localSourceId    String           @map("local_source_id")
  title            String
  description      String?
  recordingProfile RecordingProfile @map("recording_profile")
  startedAt        DateTime         @map("started_at")
  endedAt          DateTime?        @map("ended_at")
  createdAt        DateTime         @map("created_at")
  updatedAt        DateTime         @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")
  owner            User             @relation("OwnedTrips", fields: [ownerUserId], references: [id], onDelete: Cascade)
  segments         TripSegment[]
  points           TripPoint[]
  waypoints        Waypoint[]
  shares           TripShare[]

  @@unique([ownerUserId, localSourceId])
  @@index([ownerUserId])
  @@map("trips")
}

model TripSegment {
  id               String           @id @default(cuid())
  tripId           String           @map("trip_id")
  localSourceId    String           @map("local_source_id")
  recordingProfile RecordingProfile @map("recording_profile")
  startedAt        DateTime         @map("started_at")
  endedAt          DateTime?        @map("ended_at")
  createdAt        DateTime         @map("created_at")
  updatedAt        DateTime         @map("updated_at")
  trip             Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  points           TripPoint[]
  waypoints        Waypoint[]

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@map("trip_segments")
}

model TripPoint {
  id            String       @id @default(cuid())
  tripId        String       @map("trip_id")
  segmentId     String?      @map("segment_id")
  localSourceId String       @map("local_source_id")
  latitude      Float
  longitude     Float
  recordedAt    DateTime     @map("recorded_at")
  accuracy      Float?
  altitude      Float?
  speed         Float?
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  segment       TripSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@index([segmentId])
  @@map("trip_points")
}

model Waypoint {
  id            String           @id @default(cuid())
  tripId        String           @map("trip_id")
  segmentId     String?          @map("segment_id")
  localSourceId String           @map("local_source_id")
  category      WaypointCategory
  latitude      Float
  longitude     Float
  title         String
  note          String?
  createdAt     DateTime         @map("created_at")
  updatedAt     DateTime         @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")
  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  segment       TripSegment?     @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@unique([tripId, localSourceId])
  @@index([tripId])
  @@index([segmentId])
  @@map("waypoints")
}

model TripShare {
  id              String          @id @default(cuid())
  tripId          String          @map("trip_id")
  ownerUserId     String          @map("owner_user_id")
  recipientUserId String          @map("recipient_user_id")
  status          TripShareStatus @default(active)
  revokedAt       DateTime?       @map("revoked_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  owner           User            @relation("OwnerTripShares", fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipient       User            @relation("RecipientTripShares", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([tripId, recipientUserId])
  @@index([ownerUserId])
  @@index([recipientUserId])
  @@map("trip_shares")
}
