{
  "name": "@trailbook/server",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/purchases/apple-root-certificates && cp src/purchases/apple-root-certificates/*.cer dist/purchases/apple-root-certificates/",
    "start": "tsx src/main.ts",
    "start:local": "DOTENV_CONFIG_PATH=.env.local tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "db:up": "docker compose up -d postgres mailhog",
    "media:up": "docker compose up -d minio minio-init",
    "db:down": "docker compose down",
    "db:init": "docker compose cp db/init.sql postgres:/tmp/init.sql && docker compose exec -T postgres psql -U trailbook -d trailbook -f /tmp/init.sql",
    "db:test:up": "docker compose up -d postgres_test",
    "db:test:down": "docker compose stop postgres_test",
    "db:test:init": "docker compose cp db/init.sql postgres_test:/tmp/init.sql && docker compose exec -T postgres_test psql -U trailbook_test -d trailbook_test -f /tmp/init.sql",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"Lint is not configured yet for server.\""
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.17.1",
    "dotenv": "^17.4.1",
    "googleapis": "^174.0.0",
    "jose": "^6.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "prisma": "^6.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
