{
  "name": "@trailbook/server",
  "private": true,
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "db:up": "docker compose up -d postgres mailhog",
    "db:down": "docker compose down",
    "db:init": "docker compose cp db/init.sql postgres:/tmp/init.sql && docker compose exec -T postgres psql -U trailbook -d trailbook -f /tmp/init.sql",
    "db:test:up": "docker compose up -d postgres_test",
    "db:test:down": "docker compose stop postgres_test",
    "db:test:init": "docker compose cp db/init.sql postgres_test:/tmp/init.sql && docker compose exec -T postgres_test psql -U trailbook_test -d trailbook_test -f /tmp/init.sql",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test": "node --env-file=.env.test --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"Lint is not configured yet for server.\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.17.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.1",
    "jose": "^6.2.2",
    "nodemailer": "^8.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "prisma": "^6.17.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
