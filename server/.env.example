DATABASE_URL="postgresql://trailbook:trailbook@localhost:55432/trailbook?schema=public"
POSTGRES_DB="trailbook"
POSTGRES_USER="trailbook"
POSTGRES_PASSWORD="trailbook"
PORT=3001
SERVER_BODY_LIMIT="50mb"
WEB_APP_URL="http://localhost:3000"
WEB_ALLOWED_ORIGIN="http://localhost:3000"
WEB_ALLOWED_ORIGINS="http://localhost:3000"
JWT_SECRET="trailbook-local-dev-secret-change-me"
JWT_ACCESS_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
ENABLE_FAKE_PURCHASES=false
ALLOW_FAKE_PURCHASES_FOR_ALL=false
ALLOW_FAKE_PURCHASES_IN_PRODUCTION=false
PURCHASE_ENVIRONMENT=local
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://192.168.1.100:9000"
S3_REGION="us-east-1"
S3_BUCKET="trailbook-media"
S3_ACCESS_KEY_ID="trailbook"
S3_SECRET_ACCESS_KEY="trailbook-secret"
S3_FORCE_PATH_STYLE=true
MEDIA_UPLOAD_MAX_SIZE_BYTES=10485760
MEDIA_UPLOAD_ALLOWED_CONTENT_TYPES="image/jpeg,image/png,image/heic,image/heif,image/webp"
MINIO_ROOT_USER="trailbook"
MINIO_ROOT_PASSWORD="trailbook-secret"
